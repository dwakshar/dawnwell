{
  "expo": {
    "name": "Dawnwell",
    "slug": "dawnwell",
    "scheme": "dawnwell",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "app.dwakshar.dawnwell",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Dawnwell uses notifications to quietly remind you of your habits."
      }
    },
    "android": {
      "package": "app.dwakshar.dawnwell",
      "adaptiveIcon": {
        "backgroundColor": "#f5f7fa",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f5f7fa"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#0066ff"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
